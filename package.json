{
  "name": "gestor-proyectos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:realtime": "tsx workers/realtime-server.ts",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:sync-catalog": "tsx scripts/sync-product-catalog.mjs",
    "db:sync": "prisma generate && prisma migrate deploy && npm run seed",
    "news:import": "tsx scripts/import-news-json.ts",
