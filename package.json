    "db:reset": "prisma generate && prisma migrate reset --force && npm run seed",
    "worker:usage": "tsx workers/usage-reset-worker.ts",
    "worker:listener-folders": "tsx workers/listener-folder-worker.ts",
    "worker:polling-db-size": "tsx workers/polling-database-size.ts",
