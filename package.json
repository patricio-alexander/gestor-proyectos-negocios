    "app:stop": "pm2 stop ecosystem.config.cjs",
    "app:restart": "pm2 restart ecosystem.config.cjs",
    "app:logs": "pm2 logs",
    "git:push": "bash scripts/git-push.sh",
    "git-push-gestor": "bash scripts/git-push.sh",
    "deploy": "bash scripts/deploy.sh",
    "postinstall": "prisma generate",
