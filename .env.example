DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="raptorsolutions"
DATABASE_HOST="localhost"
DATABASE_PORT=3306
JWT_SECRET="cambiar-por-un-secreto-seguro-en-produccion"

# Landing (opcional)
# NEXT_PUBLIC_CONTACT_EMAIL="contacto@raptorsolutions.com"
# NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# Seed EdDeli → push entitlement (debe coincidir con GESTOR_SYNC_SECRET de EdDeli)
# Si NO definís estas vars, el seed NO pisa URL/secret ya guardados (evita marcar prod como Desarrollo).
# Solo al crear la app por primera vez usa localhost por defecto.
##EDDELI_ENTITLEMENT_URL="http://127.0.0.1:3001/eddeliapi/subscription/entitlement"
##EDDELI_ENTITLEMENT_SECRET="eddeli_gestor_sync_local_dev"
# Producción (ejemplo):
##EDDELI_ENTITLEMENT_URL="https://aplicaciones.marianosamaniego.edu.ec/eddeliapi/subscription/entitlement"

# Realtime (Socket.IO) — worker:realtime / PM2 worker-realtime
# Path del socket: {NEXT_PUBLIC_BASE_PATH}/socket.io (ej. /raptorsolutions/socket.io)
REALTIME_PORT=3003
REALTIME_INTERNAL_SECRET="cambiar-secreto-interno-realtime"
REALTIME_INTERNAL_URL="http://127.0.0.1:3003/internal/emit"
REALTIME_CORS_ORIGIN="http://localhost:3000,http://localhost:3002"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3003"
NEXT_PUBLIC_BASE_PATH=/raptorsolutions

# OTA apps móviles (URL pública absoluta opcional; si falta, se arma con Host + basePath)
