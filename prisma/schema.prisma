generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Usuarios del gestor (control plane) ───────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String?    @unique
  email        String?
  password     String?
  display_name String?
  created_at   DateTime   @default(now())
  updated_at   DateTime?  @updatedAt
  deleted_at   DateTime?
  roles        UserRole[]
}

model Role {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  name        String
  description String?    @db.VarChar(500)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  user_id String
  role_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
}

// -- OFERTAS 
model Offer {
  id         Int       @id @default(autoincrement())
  app_id     Int
  apps       Apps      @relation(fields: [app_id], references: [id])
  name       String
  price      Int?
  start_at   DateTime
  expires_at DateTime
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  offersModules OfferModule[]
  planOffers    PlanOffer[]

  @@index([app_id])
}

model OfferModule {
  offer_id  Int
  module_id Int

  offer   Offer  @relation(fields: [offer_id], references: [id])
  modules Module @relation(fields: [module_id], references: [id])

  @@id([offer_id, module_id])
}

model PlanOffer {
  plan_id  Int
  offer_id Int
  plan     Plan  @relation(fields: [plan_id], references: [id])
  offer    Offer @relation(fields: [offer_id], references: [id])

  @@id([plan_id, offer_id])
  @@index([plan_id])
}

// ─── Módulos y secciones ────────────────────────────────────────────────────

model Module {
  id            Int           @id @default(autoincrement())
  app_id        Int
  key           String
  name          String
  description   String?       @db.Text
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  apps          Apps          @relation(fields: [app_id], references: [id], onDelete: Restrict)
  sections      Section[]
  plan_modules  PlanModule[]
  offersModules OfferModule[]

  @@unique([app_id, key])
  @@index([app_id])
}

model Section {
  id                Int          @id @default(autoincrement())
  module_id         Int
  name              String
  key               String?
  max_records_limit Int?
  usage_count       Int        @default(0)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  deleted_at        DateTime?
  module            Module       @relation(fields: [module_id], references: [id], onDelete: Cascade)
  capabilities      Capability[]

  @@index([module_id])
}

model Capability {
  id         Int      @id @default(autoincrement())
  section_id Int
  code       String
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  section    Section  @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, code])
  @@index([section_id])
}

// ─── Apps / licencias ───────────────────────────────────────────────────────

model Apps {
  id            Int            @id @default(autoincrement())
  hash          String         @unique
  name          String?
  owner_name    String?
  phone         String?
  ruc           String?
  address       String?
  email         String?
  path              String?
  database_name     String?
  images_size       Float?
  database_size     Float?
  maintenance       Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
  plans         Plan[]
  modules       Module[]
  subscriptions Subscription[]
  api_keys      ApiKey[]
  offers        Offer[]
  events        Event[]
}

model ApiKey {
  id         Int      @id @default(autoincrement())
  apps       Apps     @relation(fields: [app_id], references: [id])
  app_id     Int
  name       String
  prefix     String   @unique
  hash       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Plan {
  id           Int          @id @default(autoincrement())
  name         String?
  apps         Apps         @relation(fields: [app_id], references: [id])
  app_id       Int
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  deleted_at   DateTime?
  prices       PlanPrice[]
  plan_modules PlanModule[]
  planOffers   PlanOffer[]
}

model PlanModule {
  id        Int    @id @default(autoincrement())
  plan_id   Int
  module_id Int
  plan      Plan   @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  module    Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
  @@index([module_id])
}

model PlanPrice {
  id            Int            @id @default(autoincrement())
  price         Int?
  plan          Plan           @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id       Int
  period        Period
  subscriptions Subscription[]
  licenses      License[]
}

model Subscription {
  id            Int                @id @default(autoincrement())
  apps          Apps               @relation(fields: [app_hash], references: [hash])
  app_hash      String
  plan_price    PlanPrice          @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  start_at      DateTime?
  expires_at    DateTime?
  status        SubscriptionStatus
  licenses      License[]
}

model License {
  id            Int           @id @default(autoincrement())
  subscription  Subscription? @relation(fields: [sub_id], references: [id])
  sub_id        Int?
  plan_price    PlanPrice     @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  key           String?
  status        LicenseStatus
  used_at       DateTime?
  method_pay    MethodPay?
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum LicenseStatus {
  AVAILABLE
  USED
  REVOKED
}

enum Period {
  MONTHLY
  ANNUALLY
}

enum MethodPay {
  CASH
  TRANSFER
}

// ─── Event tracking ─────────────────────────────────────────────────────────

model EventType {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String   @unique
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  events      Event[]
}

model Event {
  id         Int        @id @default(autoincrement())
  app_id     Int
  type_id    Int
  name       String
  metadata   Json?
  created_at DateTime   @default(now())
  app        Apps       @relation(fields: [app_id], references: [id])
  type       EventType  @relation(fields: [type_id], references: [id])

  @@index([app_id])
  @@index([type_id])
  @@index([created_at])
}
