generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Usuarios del gestor (control plane) ───────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String?    @unique
  email        String?
  password     String?
  display_name String?
  business_id  Int?
  created_at   DateTime   @default(now())
  updated_at   DateTime?  @updatedAt
  deleted_at   DateTime?
  roles        UserRole[]
}

model Role {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  name        String
  description String?    @db.VarChar(500)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  user_id String
  role_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
}

// ─── Módulos y secciones ────────────────────────────────────────────────────

model Module {
  id          Int       @id @default(autoincrement())
  business_id Int
  key         String
  name        String
  description String?   @db.Text
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  apps        Apps      @relation(fields: [business_id], references: [id], onDelete: Restrict)
  secciones   Seccion[]
  plan_modules PlanModule[]

  @@unique([business_id, key])
  @@index([business_id])
  @@map("BusinessModule")
}

model Seccion {
  id         Int       @id @default(autoincrement())
  module_id  Int
  name       String
  key        String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  module     Module    @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([module_id])
  @@map("BusinessModuleSection")
}

// ─── Apps / licencias ───────────────────────────────────────────────────────

model Apps {
  id            Int            @id @default(autoincrement())
  hash          String         @unique
  name          String?
  owner_name    String?
  phone         String?
  ruc           String?
  address       String?
  email         String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
  plans         Plan[]
  modules       Module[]
  subscriptions Subscription[]
  api_keys      ApiKey[]

  @@map("Business")
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  apps        Apps     @relation(fields: [business_id], references: [id])
  business_id Int
  name        String
  prefix      String   @unique
  hash        String
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String?
  apps          Apps          @relation(fields: [business_id], references: [id])
  business_id   Int
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  prices        PlanPrice[]
  plan_modules  PlanModule[]
}

model PlanModule {
  id        Int    @id @default(autoincrement())
  plan_id   Int
  module_id Int
  plan      Plan   @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  module    Module @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
  @@index([module_id])
  @@map("planes_modules")
}

model PlanPrice {
  id            Int            @id @default(autoincrement())
  price         Int?
  plan          Plan           @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id       Int
  period        Period
  subscriptions Subscription[]
  licenses      License[]
}

model Subscription {
  id            Int                @id @default(autoincrement())
  apps          Apps               @relation(fields: [business_hash], references: [hash])
  business_hash String
  plan_price    PlanPrice          @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  start_at      DateTime?
  expires_at    DateTime?
  status        SubscriptionStatus
  licenses      License[]
}

model License {
  id            Int           @id @default(autoincrement())
  subscription  Subscription? @relation(fields: [sub_id], references: [id])
  sub_id        Int?
  plan_price    PlanPrice     @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  key           String?
  status        LicenseStatus
  used_at       DateTime?
  method_pay    MethodPay?
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum LicenseStatus {
  AVAILABLE
  USED
  REVOKED
}

enum Period {
  MONTHLY
  ANNUALLY
}

enum MethodPay {
  CASH
  TRANSFER
}
