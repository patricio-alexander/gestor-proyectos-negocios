generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

/** Ciclo de vida de módulos/secciones (alineado con EdDeli appModulesCatalog). */
enum LifecycleStatus {
  active
  development
  maintenance
  developer
  planned
}

/** template = catálogo maestro (Raptor); deployment = instancia desplegada (EdDeli, Store…). */
enum AppKind {
  template
  deployment
}

// ─── Usuarios del gestor (control plane) ───────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String?    @unique
  email        String?
  password     String?
  display_name String?
  created_at   DateTime   @default(now())
  updated_at   DateTime?  @updatedAt
  deleted_at   DateTime?
  roles        UserRole[]

  @@index([deleted_at])
}

model Role {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  name        String
  description String?    @db.VarChar(500)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  user_id String
  role_id Int
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
}

// -- OFERTAS 
model Offer {
  id         Int       @id @default(autoincrement())
  app_id     Int
  apps       Apps      @relation(fields: [app_id], references: [id])
  name       String
  price      Int?
  start_at   DateTime
  expires_at DateTime
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  offersModules OfferModule[]
  planOffers    PlanOffer[]

  @@index([app_id])
  @@index([deleted_at])
  @@index([app_id, deleted_at])
}

model OfferModule {
  offer_id  Int
  module_id Int

  offer   Offer  @relation(fields: [offer_id], references: [id])
  modules Module @relation(fields: [module_id], references: [id])

  @@id([offer_id, module_id])
  @@index([module_id])
}

model PlanOffer {
  plan_id  Int
  offer_id Int
  plan     Plan  @relation(fields: [plan_id], references: [id])
  offer    Offer @relation(fields: [offer_id], references: [id])

  @@id([plan_id, offer_id])
  @@index([plan_id])
  @@index([offer_id])
}

// ─── Módulos y secciones ────────────────────────────────────────────────────

model Module {
  id            Int           @id @default(autoincrement())
  key           String        @unique
  name          String
  description      String?       @db.Text
  image_url        String?
  status           LifecycleStatus @default(active)
  is_maintainer    Boolean       @default(false)
  is_trial         Boolean       @default(false)
  limit_days_trial Int?
  start_trial      DateTime?
  end_trial        DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  sections        Section[]
  offersModules   OfferModule[]
  app_modules     AppModule[]

  @@index([status])
  @@index([deleted_at])
  @@index([deleted_at, name])
}

model Section {
  id                Int          @id @default(autoincrement())
  module_id         Int
  name              String
  key               String?
  status            LifecycleStatus @default(active)
  max_records_limit Int?
  usage_count       Int        @default(0)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  deleted_at        DateTime?
  module            Module       @relation(fields: [module_id], references: [id], onDelete: Cascade)
  capabilities      Capability[]
  app_sections      AppSection[]

  @@index([module_id])
  @@index([status])
  @@index([module_id, deleted_at])
  @@index([module_id, key])
  @@index([module_id, deleted_at, created_at])
}

/** Asignación directa módulo → app (M:N). */
model AppModule {
  id               Int             @id @default(autoincrement())
  app_id           Int
  module_id        Int
  /** null = hereda Module.status; si tiene valor = override por app. */
  status           LifecycleStatus?
  app              Apps            @relation(fields: [app_id], references: [id], onDelete: Cascade)
  module           Module          @relation(fields: [module_id], references: [id], onDelete: Cascade)
  plan_app_modules PlanAppModule[]

  @@unique([app_id, module_id])
  @@index([app_id])
  @@index([module_id])
}

/** Filtro granular de secciones por app (M:N opcional). */
model AppSection {
  app_id     Int
  section_id Int
  /** null = hereda Section.status; si tiene valor = override por app. */
  status     LifecycleStatus?
  app        Apps    @relation(fields: [app_id], references: [id], onDelete: Cascade)
  section    Section @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@id([app_id, section_id])
  @@index([app_id])
  @@index([section_id])
  @@index([section_id, status])
}

model Capability {
  id         Int      @id @default(autoincrement())
  section_id Int
  code       String
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  section    Section  @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, code])
  @@index([section_id])
  @@index([section_id, created_at])
}

// ─── Apps / licencias ───────────────────────────────────────────────────────

model Apps {
  id            Int            @id @default(autoincrement())
  hash          String         @unique
  name          String?
  owner_name    String?
  phone         String?
  ruc           String?
  address       String?
  email         String?
  path              String?
  database_name     String?
  images_size       Float?
  database_size     Float?
  maintenance       Boolean        @default(false)
  /** URL del backend de la app que recibe PUT del entitlement (ej. …/eddeliapi/subscription/entitlement). */
  entitlement_url    String?       @db.VarChar(500)
  /** Secreto compartido con la app cliente (formato: gc_<hex>). */
  entitlement_secret String?       @db.VarChar(255)
  kind               AppKind        @default(deployment)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
  subscriptions           Subscription[]
  offers                  Offer[]
  events                  Event[]
  app_modules             AppModule[]
  app_sections            AppSection[]

  @@index([deleted_at])
  @@index([deleted_at, created_at])
  @@index([kind, deleted_at])
  @@index([entitlement_secret])
}

model Plan {
  id           Int          @id @default(autoincrement())
  name         String?
  sort_order   Int          @default(0)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  deleted_at   DateTime?
  prices           PlanPrice[]
  plan_app_modules PlanAppModule[]
  planOffers       PlanOffer[]

  @@index([deleted_at])
  @@index([deleted_at, sort_order])
}

/** Módulos de una app incluidos en un plan (configuración por app). */
model PlanAppModule {
  plan_id       Int
  app_module_id Int
  plan          Plan      @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  app_module    AppModule @relation(fields: [app_module_id], references: [id], onDelete: Cascade)

  @@id([plan_id, app_module_id])
  @@index([plan_id])
  @@index([app_module_id])
}

model PlanPrice {
  id            Int            @id @default(autoincrement())
  price         Int?
  plan          Plan           @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id       Int
  period        Period
  subscriptions Subscription[]

  @@unique([plan_id, period])
}

model Subscription {
  id            Int                @id @default(autoincrement())
  apps          Apps               @relation(fields: [app_hash], references: [hash])
  app_hash      String
  plan_price    PlanPrice          @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  start_at      DateTime?
  expires_at    DateTime?
  status        SubscriptionStatus

  @@index([app_hash, status])
  @@index([status, plan_price_id])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum Period {
  MONTHLY
  ANNUALLY
}

// ─── Event tracking ─────────────────────────────────────────────────────────

enum EventSource {
  api
  webhook
}

model EventType {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String   @unique
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  events      Event[]
}

model Event {
  id         Int         @id @default(autoincrement())
  app_id     Int
  type_id    Int
  name       String
  metadata   Json?
  source     EventSource @default(api)
  created_at DateTime    @default(now())
  app        Apps        @relation(fields: [app_id], references: [id])
  type       EventType   @relation(fields: [type_id], references: [id])

  @@index([app_id])
  @@index([type_id])
  @@index([source])
  @@index([created_at])
  @@index([app_id, created_at])
}
