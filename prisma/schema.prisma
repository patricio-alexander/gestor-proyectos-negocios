generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Usuarios del gestor (control plane) ───────────────────────────────────

model User {
  id           String     @id @default(uuid())
  username     String?    @unique
  email        String?
  password     String?
  display_name String?
  business_id  Int?
  created_at   DateTime   @default(now())
  updated_at   DateTime?  @updatedAt
  deleted_at   DateTime?
  roles        UserRole[]
}

model Role {
  id          Int        @id @default(autoincrement())
  key         String     @unique
  name        String
  description String?    @db.VarChar(500)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  users       UserRole[]
}

model UserRole {
  user_id String
  role_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
}

// ─── Catálogo global EdDeli (módulos + secciones licenciables) ─────────────

model AppModule {
  id          Int          @id @default(autoincrement())
  key         String       @unique
  name        String
  description String?      @db.Text
  icon        String?      @db.VarChar(64)
  sort_order  Int          @default(0)
  app_target  String       @default("eddeli") @db.VarChar(32)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?
  sections    AppSection[]
  plan_links  PlanModule[]
}

model AppSection {
  id            Int           @id @default(autoincrement())
  app_module_id Int
  key           String
  name          String
  route_path    String?       @db.VarChar(255)
  description   String?       @db.Text
  sort_order    Int           @default(0)
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  app_module    AppModule     @relation(fields: [app_module_id], references: [id], onDelete: Cascade)
  plan_links    PlanSection[]

  @@unique([app_module_id, key])
  @@index([app_module_id])
}

// ─── Negocios / licencias ────────────────────────────────────────────────────

model Business {
  id            Int            @id @default(autoincrement())
  hash          String         @unique
  name          String?
  owner_name    String?
  phone         String?
  ruc           String?
  address       String?
  email         String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  deleted_at    DateTime?
  plans         Plan[]
  subscriptions Subscription[]
  api_keys      ApiKey[]
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  business    Business @relation(fields: [business_id], references: [id])
  business_id Int
  name        String
  prefix      String   @unique
  hash        String
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Plan {
  id            Int           @id @default(autoincrement())
  name          String?
  business      Business      @relation(fields: [business_id], references: [id])
  business_id   Int
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  deleted_at    DateTime?
  prices        PlanPrice[]
  modules       PlanModule[]
  sections      PlanSection[]
}

model PlanPrice {
  id            Int            @id @default(autoincrement())
  price         Int?
  plan          Plan           @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id       Int
  period        Period
  subscriptions Subscription[]
  licenses      License[]
}

model PlanModule {
  id            Int       @id @default(autoincrement())
  plan          Plan      @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id       Int
  app_module    AppModule @relation(fields: [app_module_id], references: [id], onDelete: Cascade)
  app_module_id Int

  @@unique([plan_id, app_module_id])
}

model PlanSection {
  id             Int        @id @default(autoincrement())
  plan           Plan       @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  plan_id        Int
  app_section    AppSection @relation(fields: [app_section_id], references: [id], onDelete: Cascade)
  app_section_id Int

  @@unique([plan_id, app_section_id])
}

model Subscription {
  id            Int                @id @default(autoincrement())
  business      Business           @relation(fields: [business_hash], references: [hash])
  business_hash String
  plan_price    PlanPrice          @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  start_at      DateTime?
  expires_at    DateTime?
  status        SubscriptionStatus
  licenses      License[]
}

model License {
  id            Int           @id @default(autoincrement())
  subscription  Subscription? @relation(fields: [sub_id], references: [id])
  sub_id        Int?
  plan_price    PlanPrice     @relation(fields: [plan_price_id], references: [id])
  plan_price_id Int
  key           String?
  status        LicenseStatus
  used_at       DateTime?
  method_pay    MethodPay?
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum LicenseStatus {
  AVAILABLE
  USED
  REVOKED
}

enum Period {
  MONTHLY
  ANNUALLY
}

enum MethodPay {
  CASH
  TRANSFER
}
